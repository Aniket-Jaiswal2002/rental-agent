# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=

# Chat model used by the agent (must support tool calling on Groq).
GROQ_MODEL=openai/gpt-oss-120b

# Client-side throttle: max requests per minute sent to Groq.
GROQ_RPM=20
# Token pacing: sleep before a request if it would push the last 60s over this many tokens (free-tier cap is 8000).
GROQ_TPM=7000
# 429 handling: retries with exponential backoff; if Groq asks us to wait longer
# than GROQ_MAX_WAIT_S seconds (e.g. daily token cap) we give up and mark RATE_LIMITED.
GROQ_MAX_RETRIES=5
GROQ_MAX_WAIT_S=900

# Speech-to-text (Groq Whisper). Leave STT_LANGUAGE empty to auto-detect English/Hinglish.
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=

# Pin "today" (YYYY-MM-DD) so relative dates resolve the same way. Evals set this themselves.
# TODAY_OVERRIDE=2026-11-02
